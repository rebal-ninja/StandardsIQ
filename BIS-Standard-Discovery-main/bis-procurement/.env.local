# StandardsIQ frontend — local development environment
# Vite reads this file automatically. Do not commit to git.

# Backend API base URL.
# With the Vite proxy configured in vite.config.ts, this can be left empty
# (the proxy forwards /api/* to 127.0.0.1:8000 automatically).
# Uncomment the line below ONLY if you are NOT using the Vite proxy
# (e.g. running the frontend against a remote backend).
# VITE_API_BASE_URL=http://127.0.0.1:8000

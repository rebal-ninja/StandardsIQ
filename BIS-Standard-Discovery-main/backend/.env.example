# StandardsIQ — environment variables
# Copy this file to .env in the REPO ROOT (not inside backend/).
# The backend reads .env from the repo root via python-dotenv.

# ── OmniRoute LLM (required for AI rationale + AI Insights) ──────────────────
# Get your key from the OmniRoute dashboard.
# Without this key the system runs in retriever-only fallback mode —
# standards are still returned but without LLM-generated explanations.
OMNIROUTE_API_KEY=your_omniroute_api_key_here

# Base URL for the OmniRoute OpenAI-compatible proxy.
# Default shown below — change only if your OmniRoute instance runs elsewhere.
OMNIROUTE_BASE_URL=http://localhost:20128/v1

# LLM model string passed to OmniRoute (optional — defaults to auto/smart).
# OMNIROUTE_MODEL=auto/smart

# ── FastAPI server (optional overrides) ──────────────────────────────────────
# HOST=0.0.0.0
# PORT=8000
